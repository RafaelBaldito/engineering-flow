#!/bin/sh
# Repository-owned, read-only environment readiness diagnostic.

script_path=$(readlink -f -- "$0" 2>/dev/null) || {
    printf '%s\n' 'ERROR runner.python unable to resolve preflight launcher' >&2
    exit 70
}
script_dir=$(dirname -- "$script_path")
root=$(dirname -- "$script_dir")

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'ERROR runner.python host python3 is unavailable; install Python 3.11 or newer to run preflight' >&2
    exit 70
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    printf '%s\n' 'ERROR runner.python host python3 must be Python 3.11 or newer to run preflight' >&2
    exit 70
fi

exec python3 "$root/tools/env_preflight.py" "$@"
